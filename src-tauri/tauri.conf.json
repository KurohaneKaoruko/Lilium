{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lilium",
  "version": "0.1.0",
  "identifier": "app.lilium.desktop",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lilium",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' http://127.0.0.1:* http://localhost:* data: blob:; media-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
